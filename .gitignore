# ---- 字体 ----
# 源可变字体与生成的中间产物都不入库；
# 只提交 app/assets/fonts 下最终使用的那两个文件，保证 clone 后可直接构建。
fonts/*.otf
fonts/*.woff2
fonts/SourceHanSerifSC-VF.ttf
fonts/full/
fonts/app/

# ---- 运行产物 ----
*.log
library/
cache/
state.db

# ---- 系统 ----
Thumbs.db
Desktop.ini
.DS_Store
